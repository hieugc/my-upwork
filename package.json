{
  "name": "my-upwork",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:task-control": "STATIC_EXPORT=0 NEXT_DIST_DIR=.next-task-runtime next build --webpack",
    "start:task-control": "STATIC_EXPORT=0 NEXT_DIST_DIR=.next-task-runtime next start -H 127.0.0.1 -p 3000",
    "serve:task-control": "pnpm start:task-control",
    "dev:task-control": "STATIC_EXPORT=0 NEXT_DIST_DIR=.next-task-control next dev --webpack -H 127.0.0.1 -p 3000"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
